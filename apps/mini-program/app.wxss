page {
  --ink: #17191b;
  --muted: #687077;
  --line: #e3e6e8;
  --paper: #ffffff;
  --canvas: #f4f5f6;
  --red: #d9433b;
  --red-soft: #faecea;
  --green: #147a55;
  --green-soft: #e8f4ee;
  --amber: #9a6200;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, picker, map, canvas, image { box-sizing: border-box; }
button::after { border: 0; }
.page { min-height: 100vh; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.content { padding: 28rpx 28rpx 36rpx; }
.section-title { margin: 12rpx 0 22rpx; font-size: 36rpx; line-height: 1.3; font-weight: 700; }
.muted { color: var(--muted); }
.small { color: var(--muted); font-size: 24rpx; }
.card { margin-bottom: 20rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--paper); }
.card-body { padding: 24rpx; }
.title { font-size: 34rpx; line-height: 1.4; font-weight: 700; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.badge { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 16rpx; border-radius: 22rpx; background: #eef0f1; color: #3f4549; font-size: 22rpx; font-weight: 600; }
.badge-red { background: var(--red-soft); color: #a6302a; }
.badge-green { background: var(--green-soft); color: var(--green); }
.badge-amber { background: #fff3d8; color: var(--amber); }
.meta { margin-top: 12rpx; color: var(--muted); font-size: 25rpx; line-height: 1.55; }
.metrics { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.metric { min-width: 0; text-align: center; border-right: 1rpx solid var(--line); }
.metric:last-child { border-right: 0; }
.metric-value { display: block; font-size: 29rpx; font-weight: 700; }
.metric-label { display: block; margin-top: 5rpx; color: var(--muted); font-size: 20rpx; }
.button { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 0; padding: 0 28rpx; border-radius: 10rpx; font-size: 28rpx; font-weight: 700; line-height: 1.25; }
.button-primary { background: var(--red); color: #fff; }
.button-dark { background: var(--ink); color: #fff; }
.button-secondary { background: #eceff0; color: var(--ink); }
.button-plain { background: #fff; color: var(--ink); border: 1rpx solid var(--line); }
.button[disabled] { opacity: .55; }
.empty-state { padding: 110rpx 40rpx; text-align: center; color: var(--muted); }
.empty-icon { display: block; margin-bottom: 24rpx; color: #adb3b6; font-size: 64rpx; }
.empty-title { color: var(--ink); font-size: 31rpx; font-weight: 700; }
.empty-copy { margin: 12rpx auto 26rpx; max-width: 520rpx; font-size: 25rpx; line-height: 1.6; }
.loading { padding: 140rpx 30rpx; text-align: center; color: var(--muted); }
.loading-dot { display: inline-block; width: 16rpx; height: 16rpx; margin-right: 14rpx; border-radius: 50%; background: var(--red); }
.form-section { margin-top: 16rpx; padding: 28rpx; background: #fff; }
.form-title { margin-bottom: 24rpx; font-size: 32rpx; font-weight: 700; }
.field { margin-bottom: 26rpx; }
.field:last-child { margin-bottom: 0; }
.label { display: block; margin-bottom: 12rpx; font-size: 25rpx; font-weight: 700; }
.required::after { content: " *"; color: var(--red); }
.input, .textarea, .picker { width: 100%; min-height: 88rpx; padding: 0 22rpx; border: 1rpx solid var(--line); border-radius: 10rpx; background: #fff; font-size: 28rpx; }
.textarea { min-height: 150rpx; padding-top: 20rpx; line-height: 1.55; }
.picker { display: flex; align-items: center; justify-content: space-between; }
.placeholder { color: #a0a6aa; }
.option-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.option { display: flex; align-items: center; min-height: 84rpx; padding: 12rpx 16rpx; border: 1rpx solid var(--line); border-radius: 10rpx; font-size: 25rpx; }
.option-selected { border-color: #e6a39f; background: var(--red-soft); color: #922e29; }
.check-box { width: 34rpx; height: 34rpx; margin-right: 12rpx; border: 2rpx solid #aeb4b7; border-radius: 6rpx; text-align: center; line-height: 30rpx; }
.option-selected .check-box { border-color: var(--red); background: var(--red); color: #fff; }
.sticky-actions { position: sticky; z-index: 5; bottom: 0; display: flex; gap: 16rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(255,255,255,.96); }
.sticky-actions .button { flex: 1; }
.notice { padding: 20rpx 22rpx; border-left: 6rpx solid var(--green); background: var(--green-soft); color: #105b41; font-size: 24rpx; line-height: 1.6; }
.status-safe { padding-bottom: env(safe-area-inset-bottom); }
