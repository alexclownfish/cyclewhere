page {
  --ink: #1c1c1e;
  --muted: #8e8e93;
  --line: rgba(60, 60, 67, .14);
  --paper: #ffffff;
  --canvas: #f3f7f5;
  --red: #ff3b30;
  --red-soft: rgba(255, 59, 48, .1);
  --green: #087f5b;
  --green-strong: #056646;
  --green-soft: rgba(8, 127, 91, .12);
  --amber: #a05a00;
  background: var(--canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

view, text, button, input, textarea, picker, map, canvas, image { box-sizing: border-box; }
button::after { border: 0; }
.page { min-height: 100vh; padding-bottom: calc(36rpx + env(safe-area-inset-bottom)); }
.content { padding: 30rpx 28rpx 42rpx; }
.section-title { margin: 12rpx 0 22rpx; font-size: 38rpx; line-height: 1.3; font-weight: 750; }
.muted { color: var(--muted); }
.small { color: var(--muted); font-size: 24rpx; }
.card { margin-bottom: 22rpx; overflow: hidden; border: 0; border-radius: 16rpx; background: rgba(255,255,255,.96); box-shadow: 0 2rpx 2rpx rgba(0,0,0,.03), 0 14rpx 40rpx rgba(0,0,0,.045); }
.card-body { padding: 24rpx; }
.title { font-size: 36rpx; line-height: 1.4; font-weight: 750; }
.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.badge { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 17rpx; border-radius: 22rpx; background: rgba(118,118,128,.1); color: #3a3a3c; font-size: 22rpx; font-weight: 650; }
.badge-red { background: var(--red-soft); color: #d70015; }
.badge-green { background: var(--green-soft); color: var(--green); }
.badge-amber { background: rgba(255,149,0,.14); color: var(--amber); }
.meta { margin-top: 12rpx; color: var(--muted); font-size: 25rpx; line-height: 1.55; }
.metrics { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.metric { min-width: 0; text-align: center; border-right: 1rpx solid var(--line); }
.metric:last-child { border-right: 0; }
.metric-value { display: block; font-size: 29rpx; font-weight: 700; }
.metric-label { display: block; margin-top: 5rpx; color: var(--muted); font-size: 20rpx; }
.button { display: flex; align-items: center; justify-content: center; min-height: 96rpx; margin: 0; padding: 0 28rpx; border-radius: 24rpx; font-size: 28rpx; font-weight: 650; line-height: 1.25; }
.button-primary { background: var(--green); color: #fff; }
.button-dark { background: var(--ink); color: #fff; }
.button-secondary { background: var(--green-soft); color: var(--green-strong); }
.button-plain { background: rgba(118,118,128,.1); color: var(--green-strong); border: 0; }
.button[disabled] { opacity: .55; }
.empty-state { padding: 110rpx 40rpx; text-align: center; color: var(--muted); }
.empty-icon { display: block; margin-bottom: 24rpx; color: #adb3b6; font-size: 64rpx; }
.empty-title { color: var(--ink); font-size: 31rpx; font-weight: 700; }
.empty-copy { margin: 12rpx auto 26rpx; max-width: 520rpx; font-size: 25rpx; line-height: 1.6; }
.loading { padding: 140rpx 30rpx; text-align: center; color: var(--muted); }
.loading-dot { display: inline-block; width: 16rpx; height: 16rpx; margin-right: 14rpx; border-radius: 50%; background: var(--green); }
.form-section { margin-top: 16rpx; padding: 30rpx 28rpx; background: #fff; }
.form-title { margin-bottom: 24rpx; font-size: 34rpx; font-weight: 750; }
.field { margin-bottom: 26rpx; }
.field:last-child { margin-bottom: 0; }
.label { display: block; margin-bottom: 12rpx; color: #3a3a3c; font-size: 24rpx; font-weight: 650; }
.required::after { content: " *"; color: var(--red); }
.input, .textarea, .picker { width: 100%; min-height: 88rpx; padding: 0 22rpx; border: 0; border-radius: 20rpx; background: rgba(118,118,128,.1); font-size: 28rpx; }
.textarea { min-height: 150rpx; padding-top: 20rpx; line-height: 1.55; }
.picker { display: flex; align-items: center; justify-content: space-between; }
.placeholder { color: #a0a6aa; }
.option-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; }
.option { display: flex; align-items: center; min-height: 88rpx; padding: 12rpx 16rpx; border: 0; border-radius: 20rpx; background: rgba(118,118,128,.09); font-size: 25rpx; }
.option-selected { background: var(--green-soft); color: var(--green-strong); }
.check-box { width: 34rpx; height: 34rpx; margin-right: 12rpx; border: 2rpx solid #aeb4b7; border-radius: 6rpx; text-align: center; line-height: 30rpx; }
.option-selected .check-box { border-color: var(--green); background: var(--green); color: #fff; }
.sticky-actions { position: sticky; z-index: 5; bottom: 0; display: flex; gap: 16rpx; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: rgba(248,251,249,.96); }
.sticky-actions .button { flex: 1; }
.notice { padding: 20rpx 22rpx; border: 0; border-radius: 20rpx; background: var(--green-soft); color: var(--green-strong); font-size: 24rpx; line-height: 1.6; }
.status-safe { padding-bottom: env(safe-area-inset-bottom); }

/* Inline modal keeps confirmations consistent with the light Apple-style UI. */
.apple-modal-backdrop { position: fixed; z-index: 1000; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; background: rgba(28, 28, 30, .26); -webkit-backdrop-filter: blur(18rpx); backdrop-filter: blur(18rpx); }
.apple-modal { width: 100%; max-width: 620rpx; overflow: hidden; border: 1rpx solid rgba(255,255,255,.72); border-radius: 30rpx; background: rgba(255,255,255,.97); box-shadow: 0 26rpx 80rpx rgba(0,0,0,.2), 0 2rpx 8rpx rgba(0,0,0,.08); animation: apple-modal-in .18s ease-out; }
.apple-modal-title { padding: 36rpx 34rpx 0; color: var(--ink); font-size: 34rpx; font-weight: 750; line-height: 1.3; text-align: center; }
.apple-modal-content { padding: 16rpx 42rpx 34rpx; color: #5c5c60; font-size: 26rpx; line-height: 1.6; text-align: center; white-space: pre-line; word-break: break-word; }
.apple-modal-actions { display: flex; border-top: 1rpx solid rgba(60,60,67,.12); }
.apple-modal-button { flex: 1; min-height: 96rpx; margin: 0; padding: 0 18rpx; border-radius: 0; background: transparent; color: var(--green); font-size: 28rpx; font-weight: 650; line-height: 96rpx; }
.apple-modal-button + .apple-modal-button { border-left: 1rpx solid rgba(60,60,67,.12); }
.apple-modal-cancel { color: #636366; font-weight: 500; }
.apple-modal-destructive { color: #d70015; }
@keyframes apple-modal-in { from { opacity: 0; transform: scale(.96) translateY(10rpx); } to { opacity: 1; transform: scale(1) translateY(0); } }
