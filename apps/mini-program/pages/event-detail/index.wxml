<view class="page">
  <view wx:if="{{loading}}" class="loading"><text class="loading-dot"></text>正在加载活动详情</view>
  <view wx:elif="{{error}}" class="empty-state"><text class="empty-icon">!</text><view class="empty-title">活动暂不可用</view><view class="empty-copy">{{error}}</view><button class="button button-plain" bindtap="loadDetail">重试</button></view>
  <block wx:elif="{{event}}">
    <view class="hero-shell"><image class="hero-cover" src="{{event.coverUrl || event.route.cover}}" mode="aspectFill" /><view class="hero-route-chip">{{event.route.distanceKm}} km · 爬升 {{event.route.elevationGainM}} m</view></view>
    <view class="summary">
      <view class="row-between"><view><text class="badge {{event.status === 'published' ? 'badge-red' : ''}}">{{statusText}}</text><text wx:if="{{event.approvalRequired}}" class="badge">审核制</text></view><text class="small">剩余 {{remaining}} 位</text></view>
      <view class="detail-title">{{event.title}}</view>
      <view class="organizer"><view class="avatar"><image wx:if="{{event.organizerAvatarUrl}}" class="avatar-image" src="{{event.organizerAvatarUrl}}" mode="aspectFill" /><text wx:else>{{organizerInitial}}</text></view><view class="organizer-copy"><view>{{event.organizer}}</view><view class="small">活动组织者</view></view><view class="verified-mark">✓</view></view>
    </view>
    <view class="detail-section">
      <view class="section-kicker">RIDE PLAN</view><view class="form-title">出发信息</view>
      <view class="info-grid"><view class="info"><text class="info-label">时间</text><text>{{dateText}}</text></view><view class="info"><text class="info-label">集合</text><text>{{event.meetingPoint}}</text></view><view class="info"><text class="info-label">巡航</text><text>{{event.speedRange}}</text></view><view class="info"><text class="info-label">规模</text><text>{{event.registeredCount}} / {{event.capacity}} 人</text></view></view>
    </view>
    <view id="participant-list" class="detail-section participants-section">
      <view class="participants-heading">
        <view><view class="section-kicker">RIDERS</view><view class="form-title">一起出发的骑友</view></view>
        <view class="participant-count">{{participants.length}} 位同行</view>
      </view>
      <view wx:if="{{participantsLoading}}" class="participants-loading"><text class="loading-dot"></text>正在同步报名骑友</view>
      <view wx:elif="{{participantsError}}" class="participants-failed">
        <view>报名骑友暂时加载失败</view>
        <button class="participants-retry" bindtap="loadParticipants">重新加载</button>
      </view>
      <view wx:elif="{{!participants.length}}" class="participants-empty">
        <view class="participants-empty-mark">+</view>
        <view><view class="participants-empty-title">还没有骑友报名</view><view class="participants-empty-copy">成为第一位加入这场骑行的骑友</view></view>
      </view>
      <view wx:else class="participant-grid">
        <view wx:for="{{participants}}" wx:for-index="index" wx:key="key" class="participant-item {{item.contactId ? 'participant-actionable' : ''}}" data-participant-index="{{index}}" bindtap="openParticipant">
          <view class="participant-avatar">
            <image wx:if="{{item.avatarUrl}}" class="participant-avatar-image" src="{{item.avatarUrl}}" mode="aspectFill" lazy-load />
            <text wx:else>{{item.avatarText}}</text>
          </view>
          <view class="participant-name">{{item.displayName}}</view>
          <view wx:if="{{item.isOrganizer}}" class="participant-role">组织者</view>
          <view wx:elif="{{item.contactLoading}}" class="participant-role">加载中</view>
        </view>
      </view>
    </view>
    <view class="detail-section route-entry" bindtap="openRoute">
      <view class="row-between"><view><view class="form-title route-name">{{event.route.name}}</view><view class="small">{{event.route.distanceKm}} km · 爬升 {{event.route.elevationGainM}} m · {{event.route.difficulty}}</view></view><text class="chevron">›</text></view>
      <view class="route-track"><view class="route-line"></view><view class="route-dot route-start"></view><view class="route-dot route-end"></view></view>
      <view class="small route-hint">路线仅供参考，出发前请下载离线轨迹并留意现场路况。</view>
    </view>
    <view class="detail-section">
      <view class="section-kicker">READINESS</view><view class="form-title">装备与能力要求</view>
      <view class="require-group"><view class="require-label">必备装备</view><view class="tag-wrap"><text wx:for="{{event.requirements.equipment}}" wx:key="*this" class="tag">{{item}}</text></view></view>
      <view class="require-group"><view class="require-label">能力门槛</view><view class="require-copy">近 30 天完成过 {{event.requirements.recentDistanceKm}} km 以上骑行，累计爬升不低于 {{event.requirements.recentElevationM}} m；允许 {{bikeTypesText}}。</view></view>
      <view class="require-group"><view class="require-label">队伍纪律</view><view wx:for="{{event.requirements.disciplines}}" wx:key="*this" class="rule"><text class="rule-mark">✓</text>{{item}}</view></view>
      <view wx:if="{{event.requirements.customNote}}" class="risk"><text class="risk-mark">!</text>{{event.requirements.customNote}}</view>
    </view>
    <view class="detail-section"><view class="section-kicker">ABOUT</view><view class="form-title">活动说明</view><view class="description">{{event.description}}</view></view>
    <view class="sticky-actions">
      <block wx:if="{{event.ownedByMe}}">
        <button class="button button-plain cancel owner-cancel" disabled="{{event.status === 'cancelled' || event.status === 'completed'}}" loading="{{eventCancelling}}" bindtap="cancelEvent">{{event.status === 'cancelled' ? '活动已取消' : '取消活动'}}</button>
        <button class="button button-primary owner-participants" bindtap="viewParticipants">查看已报名用户</button>
      </block>
      <block wx:else>
        <button wx:if="{{registration}}" class="button button-plain cancel" loading="{{cancelling}}" bindtap="cancelRegistration">取消报名</button>
        <button class="button button-primary" disabled="{{!registration && !canRegisterNow}}" bindtap="handlePrimary">{{actionText}}</button>
      </block>
    </view>
  </block>

  <view wx:if="{{appleModal.visible}}" class="apple-modal-backdrop" catchtouchmove="noop" catchtap="noop">
    <view class="apple-modal" catchtap="noop">
      <view class="apple-modal-title">{{appleModal.title}}</view>
      <view class="apple-modal-content">{{appleModal.content}}</view>
      <view class="apple-modal-actions">
        <button wx:if="{{appleModal.showCancel}}" class="apple-modal-button apple-modal-cancel" data-confirm="false" catchtap="resolveAppleModal">{{appleModal.cancelText}}</button>
        <button class="apple-modal-button {{appleModal.destructive ? 'apple-modal-destructive' : ''}}" data-confirm="true" catchtap="resolveAppleModal">{{appleModal.confirmText}}</button>
      </view>
    </view>
  </view>
</view>
