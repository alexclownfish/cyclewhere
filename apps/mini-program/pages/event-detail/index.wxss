.hero-shell { position: relative; height: 488rpx; background: #202326; }
.hero-cover { display: block; width: 100%; height: 100%; background: #202326; }
.hero-route-chip { position: absolute; right: 24rpx; bottom: 52rpx; padding: 11rpx 18rpx; border: 1rpx solid rgba(255,255,255,.5); border-radius: 26rpx; background: rgba(22,29,26,.62); color: #fff; font-size: 22rpx; -webkit-backdrop-filter: blur(18rpx); backdrop-filter: blur(18rpx); }
.summary { position: relative; z-index: 2; margin-top: -28rpx; padding: 34rpx 28rpx 24rpx; border-radius: 28rpx 28rpx 0 0; background: rgba(255,255,255,.97); }
.badge + .badge { margin-left: 12rpx; }
.summary .badge-red { background: var(--green-soft); color: var(--green-strong); }
.detail-title { margin: 20rpx 0 22rpx; font-size: 46rpx; line-height: 1.28; font-weight: 800; }
.organizer { display: flex; align-items: center; gap: 18rpx; padding: 18rpx; border-radius: 20rpx; background: rgba(8,127,91,.055); }
.avatar { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 50%; background: var(--green); color: #fff; font-weight: 700; box-shadow: 0 8rpx 20rpx rgba(8,127,91,.2); }
.avatar-image { display: block; width: 100%; height: 100%; border-radius: 50%; }
.organizer-copy { flex: 1; min-width: 0; }.verified-mark { display: flex; align-items: center; justify-content: center; width: 36rpx; height: 36rpx; border-radius: 50%; background: var(--green); color: #fff; font-size: 21rpx; font-weight: 800; }
.detail-section { margin-top: 12rpx; padding: 32rpx 28rpx; background: rgba(255,255,255,.96); }
.section-kicker { margin-bottom: 7rpx; color: var(--green); font-size: 20rpx; font-weight: 750; }
.detail-section .form-title { margin-bottom: 24rpx; }
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28rpx 22rpx; }
.info { min-width: 0; padding: 18rpx; border-radius: 18rpx; background: var(--canvas); line-height: 1.5; }
.info-label { display: block; margin-bottom: 5rpx; color: var(--muted); font-size: 23rpx; }
.participants-section { min-height: 220rpx; }
.participants-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24rpx; }
.participants-heading .form-title { margin-bottom: 0; }
.participant-count { flex: 0 0 auto; padding-bottom: 3rpx; color: var(--green-strong); font-size: 22rpx; font-weight: 650; }
.participants-loading { display: flex; align-items: center; min-height: 118rpx; color: var(--muted); font-size: 23rpx; }
.participants-failed { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; min-height: 104rpx; margin-top: 20rpx; padding: 20rpx 22rpx; border-radius: 18rpx; background: var(--red-soft); color: #b42318; font-size: 23rpx; }
.participants-retry { flex: 0 0 auto; min-height: 54rpx; margin: 0; padding: 0 18rpx; border-radius: 27rpx; background: #fff; color: #b42318; font-size: 21rpx; font-weight: 650; line-height: 54rpx; }
.participants-empty { display: flex; align-items: center; gap: 18rpx; margin-top: 22rpx; padding: 24rpx; border-radius: 20rpx; background: var(--green-soft); }
.participants-empty-mark { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 50%; background: #fff; color: var(--green); font-size: 37rpx; font-weight: 500; }
.participants-empty-title { color: var(--ink); font-size: 25rpx; font-weight: 700; }
.participants-empty-copy { margin-top: 6rpx; color: #52615b; font-size: 21rpx; line-height: 1.45; }
.participant-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 24rpx 12rpx; margin-top: 28rpx; }
.participant-item { min-width: 0; text-align: center; }
.participant-actionable { cursor: pointer; }
.participant-avatar { display: flex; align-items: center; justify-content: center; width: 82rpx; height: 82rpx; margin: 0 auto; overflow: hidden; border: 5rpx solid #fff; border-radius: 50%; background: var(--green); color: #fff; font-size: 28rpx; font-weight: 750; box-shadow: 0 0 0 2rpx rgba(8,127,91,.16), 0 8rpx 18rpx rgba(8,60,43,.12); }
.participant-avatar-image { display: block; width: 100%; height: 100%; }
.participant-name { overflow: hidden; margin-top: 10rpx; color: #454b4f; font-size: 21rpx; line-height: 1.3; text-overflow: ellipsis; white-space: nowrap; }
.participant-role { margin-top: 4rpx; color: var(--green); font-size: 18rpx; line-height: 1.2; }
.route-entry { min-height: 270rpx; background: rgba(8,127,91,.075); }
.route-name { margin-bottom: 5rpx; }
.chevron { display: flex; align-items: center; justify-content: center; width: 58rpx; height: 58rpx; border-radius: 50%; background: rgba(255,255,255,.78); color: var(--green); font-size: 46rpx; }
.route-track { position: relative; height: 82rpx; margin: 20rpx 10rpx 10rpx; }
.route-line { position: absolute; top: 36rpx; left: 18rpx; right: 18rpx; height: 9rpx; border-radius: 8rpx; background: var(--green); transform: rotate(-3deg); opacity: .78; }
.route-dot { position: absolute; top: 25rpx; width: 28rpx; height: 28rpx; border: 6rpx solid #fff; border-radius: 50%; background: var(--green-strong); box-shadow: 0 4rpx 12rpx rgba(8,127,91,.22); }
.route-start { left: 4rpx; }.route-end { right: 4rpx; background: var(--green); }
.route-hint { line-height: 1.5; }
.require-group { margin-bottom: 28rpx; }
.require-label { margin-bottom: 13rpx; font-size: 25rpx; font-weight: 700; }
.tag-wrap { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { padding: 11rpx 16rpx; border-radius: 18rpx; background: var(--green-soft); color: var(--green-strong); font-size: 24rpx; }
.require-copy, .rule, .description { color: #454b4f; font-size: 26rpx; line-height: 1.75; }
.rule { display: flex; margin-top: 10rpx; }.rule-mark { margin-right: 12rpx; color: var(--green); font-weight: 700; }
.risk { display: flex; padding: 20rpx; border-radius: 18rpx; background: rgba(255,149,0,.12); color: #784e08; font-size: 24rpx; line-height: 1.6; }
.risk-mark { flex: 0 0 auto; margin-right: 14rpx; font-weight: 800; }
.cancel { max-width: 210rpx; }
.sticky-actions { background: rgba(247,251,249,.9); -webkit-backdrop-filter: blur(24rpx); backdrop-filter: blur(24rpx); }
