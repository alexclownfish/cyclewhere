.hero-cover { display: block; width: 100%; height: 470rpx; background: #202326; }
.summary { position: relative; margin-top: -30rpx; padding: 32rpx 28rpx 22rpx; border-radius: 14rpx 14rpx 0 0; background: #fff; }
.badge + .badge { margin-left: 12rpx; }
.detail-title { margin: 18rpx 0 20rpx; font-size: 44rpx; line-height: 1.3; font-weight: 800; }
.organizer { display: flex; align-items: center; gap: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.avatar { display: flex; align-items: center; justify-content: center; width: 74rpx; height: 74rpx; border-radius: 50%; background: #17191b; color: #fff; font-weight: 700; }
.detail-section { margin-top: 14rpx; padding: 30rpx 28rpx; background: #fff; }
.info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28rpx 22rpx; }
.info { min-width: 0; line-height: 1.5; }
.info-label { display: block; margin-bottom: 5rpx; color: var(--muted); font-size: 23rpx; }
.route-entry { min-height: 270rpx; }
.route-name { margin-bottom: 5rpx; }
.chevron { font-size: 52rpx; color: #7b8185; }
.route-track { position: relative; height: 82rpx; margin: 20rpx 10rpx 10rpx; }
.route-line { position: absolute; top: 36rpx; left: 18rpx; right: 18rpx; height: 9rpx; border-radius: 8rpx; background: linear-gradient(90deg, #147a55 0 28%, #d9433b 28% 67%, #147a55 67%); transform: rotate(-3deg); }
.route-dot { position: absolute; top: 25rpx; width: 28rpx; height: 28rpx; border: 6rpx solid #fff; border-radius: 50%; background: #17191b; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.18); }
.route-start { left: 4rpx; }.route-end { right: 4rpx; background: var(--red); }
.route-hint { line-height: 1.5; }
.require-group { margin-bottom: 28rpx; }
.require-label { margin-bottom: 13rpx; font-size: 25rpx; font-weight: 700; }
.tag-wrap { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { padding: 11rpx 16rpx; border-radius: 8rpx; background: #eef0f1; font-size: 24rpx; }
.require-copy, .rule, .description { color: #454b4f; font-size: 26rpx; line-height: 1.75; }
.rule { display: flex; margin-top: 10rpx; }.rule-mark { margin-right: 12rpx; color: var(--green); font-weight: 700; }
.risk { display: flex; padding: 20rpx; border-radius: 8rpx; background: #fff3d8; color: #784e08; font-size: 24rpx; line-height: 1.6; }
.risk-mark { flex: 0 0 auto; margin-right: 14rpx; font-weight: 800; }
.cancel { max-width: 210rpx; }
