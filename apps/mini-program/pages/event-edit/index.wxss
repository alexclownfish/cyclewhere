@import "../publish/index.wxss";
.edit-page { padding-bottom: 210rpx; }
.edit-head { margin: 24rpx 24rpx 0; padding: 34rpx 30rpx 28rpx; border-radius: 28rpx; color: #fff; background: #087f5b; box-shadow: 0 18rpx 44rpx rgba(8,127,91,.2); }
.edit-head .head-kicker { color: rgba(255,255,255,.72); }
.edit-head .head-copy { color: rgba(255,255,255,.78); }
.quota-row { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(255,255,255,.2); }
.quota-dots { display: flex; gap: 10rpx; }.quota-dot { width: 38rpx; height: 8rpx; border-radius: 6rpx; background: rgba(255,255,255,.25); }.quota-used { background: #fff; }
.quota-copy { font-size: 23rpx; font-weight: 650; }
.limit-banner { display: flex; gap: 18rpx; margin: 22rpx 24rpx 0; padding: 24rpx; border: 1rpx solid rgba(255,149,0,.22); border-radius: 22rpx; background: #fff7e8; color: #704500; }
.limit-locked { border-color: rgba(255,59,48,.18); background: #fff1ef; color: #8d2018; }
.limit-icon { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 50%; background: rgba(255,255,255,.8); font-weight: 800; }
.limit-title { font-size: 25rpx; font-weight: 750; }.limit-copy { margin-top: 5rpx; font-size: 22rpx; line-height: 1.5; opacity: .85; }
.section-title { color: var(--ink); font-size: 30rpx; font-weight: 750; }
.change-section { margin: 22rpx 24rpx; padding: 30rpx; border: 2rpx solid rgba(8,127,91,.18); border-radius: 24rpx; background: #fff; }
.change-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }.change-tip { margin-top: 7rpx; color: var(--muted); font-size: 22rpx; }
.counter { color: var(--muted); font-size: 22rpx; }.counter-limit { color: #c24132; }
.summary-input { box-sizing: border-box; width: 100%; height: 164rpx; margin-top: 22rpx; padding: 22rpx; border: 1rpx solid rgba(20,39,31,.12); border-radius: 18rpx; background: #f7faf8; font-size: 26rpx; line-height: 1.6; }
.summary-input.auto-summary[disabled] { opacity: 1; color: var(--ink); }
.preview { margin-top: 20rpx; padding: 22rpx; border-left: 6rpx solid var(--green); border-radius: 8rpx 18rpx 18rpx 8rpx; background: var(--green-soft); }
.preview-label { color: var(--green); font-size: 20rpx; font-weight: 700; }.preview-title { margin-top: 8rpx; color: var(--ink); font-size: 25rpx; font-weight: 750; }.preview-copy { margin-top: 8rpx; color: #44544d; font-size: 24rpx; line-height: 1.55; }
input[disabled], textarea[disabled] { opacity: .62; }
