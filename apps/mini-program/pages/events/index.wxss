.hero { padding: 48rpx 32rpx 56rpx; background: #17191b; color: #fff; }
.hero-kicker { color: #d69b97; font-size: 23rpx; font-weight: 700; }
.hero-title { margin-top: 10rpx; font-size: 48rpx; line-height: 1.25; font-weight: 800; }
.hero-copy { margin-top: 12rpx; color: #c7ccce; font-size: 25rpx; }
.search-wrap { margin: -28rpx 28rpx 20rpx; }
.search { min-height: 88rpx; padding: 0 26rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(0,0,0,.08); }
.filters { white-space: nowrap; }
.filter-row { display: inline-flex; gap: 14rpx; padding: 0 28rpx 20rpx; }
.filter { min-width: 112rpx; min-height: 68rpx; padding: 0 24rpx; border: 1rpx solid var(--line); border-radius: 34rpx; background: #fff; font-size: 25rpx; line-height: 68rpx; }
.filter-active { border-color: #17191b; background: #17191b; color: #fff; }
.event-list { padding-top: 6rpx; }
.event-cover { display: block; width: 100%; height: 330rpx; background: #dfe2e3; }
.event-title { margin-top: 15rpx; }
