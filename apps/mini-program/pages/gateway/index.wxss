page { height: 100%; overflow: hidden; background: #f3f8f5; }
.gateway-page { position: relative; min-height: 100vh; padding: 0 34rpx calc(42rpx + env(safe-area-inset-bottom)); overflow: hidden; color: #17352a; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif; }
.gateway-glow { position: absolute; top: 0; right: 0; left: 0; height: 530rpx; background: radial-gradient(circle at 50% 34%, rgba(8,127,91,.18), transparent 44%); opacity: .5; }
.safe-top { height: calc(82rpx + env(safe-area-inset-top)); }
.gateway-brand { position: relative; z-index: 2; color: #087f5b; font-size: 22rpx; font-weight: 750; text-align: center; }
.gateway-title { position: relative; z-index: 2; margin-top: 22rpx; font-size: 54rpx; font-weight: 800; line-height: 1.25; text-align: center; }
.gateway-copy { position: relative; z-index: 2; margin-top: 13rpx; color: #68766f; font-size: 24rpx; text-align: center; }
.bike-stage { position: relative; z-index: 2; height: 430rpx; margin: 34rpx -34rpx 0; overflow: hidden; }
.bike-sun { position: absolute; top: 34rpx; right: 84rpx; width: 76rpx; height: 76rpx; border-radius: 50%; background: #d7f28a; box-shadow: 0 0 0 22rpx rgba(215,242,138,.22); }
.bike-hill { position: absolute; left: -15%; bottom: 68rpx; width: 72%; height: 190rpx; border-radius: 50% 50% 0 0; background: #dcece3; transform: rotate(7deg); }
.bike-hill-right { left: 46%; bottom: 66rpx; width: 82%; height: 230rpx; background: #cfe4d8; transform: rotate(-9deg); }
.bike-road { position: absolute; right: 0; bottom: 66rpx; left: 0; height: 8rpx; background: #174a38; }
.bike-road::after { position: absolute; top: 28rpx; right: -20%; left: -20%; height: 2rpx; background: rgba(23,74,56,.14); content: ""; }
.bike-rider { position: absolute; bottom: 72rpx; left: 50%; width: 194rpx; height: 135rpx; transform: translateX(-50%); animation: gateway-ride 2.4s ease-in-out infinite; }
.bike-wheel { position: absolute; bottom: 0; width: 65rpx; height: 65rpx; border: 6rpx solid #087f5b; border-radius: 50%; }
.bike-wheel-left { left: 4rpx; }.bike-wheel-right { right: 4rpx; }
.bike-frame { position: absolute; height: 6rpx; border-radius: 4rpx; background: #087f5b; transform-origin: left center; }
.bike-frame-main { left: 39rpx; bottom: 36rpx; width: 78rpx; transform: rotate(-6deg); box-shadow: 33rpx -34rpx 0 -1rpx #087f5b; }
.bike-frame-top { left: 68rpx; bottom: 70rpx; width: 61rpx; transform: rotate(22deg); }
.bike-fork { position: absolute; right: 43rpx; bottom: 32rpx; width: 6rpx; height: 73rpx; border-radius: 4rpx; background: #087f5b; transform: rotate(-19deg); transform-origin: bottom; }
.bike-seat { position: absolute; left: 70rpx; bottom: 87rpx; width: 30rpx; height: 7rpx; border-radius: 6rpx; background: #174a38; }
.rider-body { position: absolute; left: 88rpx; bottom: 86rpx; width: 55rpx; height: 12rpx; border-radius: 9rpx; background: #087f5b; transform: rotate(51deg); }
.rider-head { position: absolute; left: 96rpx; bottom: 124rpx; width: 25rpx; height: 25rpx; border-radius: 50%; background: #087f5b; }
.rider-arm, .rider-leg { position: absolute; height: 7rpx; border-radius: 6rpx; background: #087f5b; transform-origin: left center; }
.rider-arm { left: 111rpx; bottom: 94rpx; width: 50rpx; transform: rotate(12deg); }.rider-leg { left: 94rpx; bottom: 76rpx; width: 55rpx; transform: rotate(34deg); }
.speed-line { position: absolute; right: 62%; height: 3rpx; border-radius: 3rpx; background: rgba(8,127,91,.22); animation: speed-line 1.25s ease-in-out infinite; }
.speed-one { bottom: 155rpx; width: 92rpx; }.speed-two { bottom: 126rpx; width: 60rpx; animation-delay: .22s; }.speed-three { bottom: 190rpx; width: 48rpx; animation-delay: .42s; }
.gateway-loading { position: relative; z-index: 2; margin-top: -10rpx; color: #68766f; font-size: 22rpx; text-align: center; transition: opacity .22s ease; }
.gateway-progress { width: 240rpx; height: 7rpx; margin: 20rpx auto 0; overflow: hidden; border-radius: 7rpx; background: rgba(8,127,91,.12); }.gateway-progress view { width: 45%; height: 100%; border-radius: inherit; background: #087f5b; animation: loading-track 1.2s ease-in-out infinite; }
.gateway-actions { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 30rpx; opacity: 0; transform: translateY(24rpx); pointer-events: none; transition: opacity .35s ease, transform .35s ease; }
.gateway-ready .gateway-actions { opacity: 1; transform: translateY(0); pointer-events: auto; }.gateway-ready .gateway-loading { opacity: 0; }
.gateway-action { position: relative; display: flex; min-width: 0; min-height: 218rpx; flex-direction: column; align-items: flex-start; justify-content: center; margin: 0; padding: 28rpx 26rpx; border: 1rpx solid rgba(8,127,91,.11); border-radius: 30rpx; background: rgba(255,255,255,.94); color: #17352a; text-align: left; box-shadow: 0 20rpx 50rpx rgba(8,77,54,.08); }
.gateway-action[disabled] { opacity: 1; }.gateway-primary { border-color: transparent; background: #087f5b; color: #fff; box-shadow: 0 24rpx 54rpx rgba(8,127,91,.2); }
.action-head { display: flex; width: 100%; align-items: center; justify-content: space-between; }.action-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 22rpx; background: rgba(8,127,91,.1); color: #087f5b; }.gateway-primary .action-icon { background: rgba(255,255,255,.16); color: #fff; }.plus-icon { font-size: 43rpx; font-weight: 400; }.action-arrow { font-size: 43rpx; font-weight: 300; }
.people-icon { position: relative; }.people-icon view { position: absolute; width: 19rpx; height: 19rpx; border: 4rpx solid currentColor; border-radius: 50%; }.people-icon view:first-child { left: 17rpx; top: 14rpx; }.people-icon view:last-child { right: 15rpx; top: 18rpx; }.people-icon::after { position: absolute; bottom: 14rpx; left: 15rpx; width: 40rpx; height: 22rpx; border: 4rpx solid currentColor; border-bottom: 0; border-radius: 24rpx 24rpx 0 0; content: ""; }
.action-title { margin-top: 22rpx; font-size: 30rpx; font-weight: 800; }.action-copy { margin-top: 7rpx; color: #718078; font-size: 19rpx; line-height: 1.45; }.gateway-primary .action-copy { color: rgba(255,255,255,.72); }
@keyframes gateway-ride { 0%,100% { transform: translateX(-50%) translateY(0) rotate(-1deg); } 50% { transform: translateX(-50%) translateY(-12rpx) rotate(1deg); } }
@keyframes speed-line { 0% { opacity: 0; transform: translateX(50rpx) scaleX(.5); } 45% { opacity: 1; } 100% { opacity: 0; transform: translateX(-50rpx) scaleX(1.2); } }
@keyframes loading-track { 0% { transform: translateX(-110%); } 100% { transform: translateX(230%); } }
