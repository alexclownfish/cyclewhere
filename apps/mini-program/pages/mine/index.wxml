<view class="page mine-page">
  <view wx:if="{{authChecking}}" class="auth-loading">
    <view class="loading-mark"><view class="loading-pulse"></view></view>
    <view class="loading-title">正在连接微信</view>
    <view class="loading-copy">正在确认账号状态，请稍候</view>
  </view>

  <view wx:elif="{{authRequired}}" class="login-shell">
    <view class="login-hero">
      <view class="login-brand"><text class="brand-dot"></text>风迹骑行</view>
      <view class="login-title">建立你的骑友身份</view>
      <view class="login-copy">使用微信头像和昵称完成登录，即可报名、发布和管理骑行活动。</view>
    </view>

    <view class="login-panel">
      <view class="avatar-section">
        <button class="avatar-picker" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" aria-label="选择微信头像">
          <image wx:if="{{pendingAvatarUrl}}" src="{{pendingAvatarUrl}}" mode="aspectFill" />
          <view wx:else class="avatar-placeholder"><text>+</text></view>
          <view class="avatar-action">+</view>
        </button>
        <view class="avatar-label">微信头像</view>
        <view class="avatar-help">点击头像进行选择</view>
      </view>

      <view class="form-divider"></view>
      <view class="login-field">
        <view class="field-label">微信昵称</view>
        <input class="nickname-input" type="nickname" maxlength="32" value="{{pendingNickname}}" bindinput="onNickname" placeholder="选择或填写微信昵称" placeholder-class="input-placeholder" />
      </view>

      <view wx:if="{{authError}}" class="login-error">
        <view class="error-indicator">!</view>
        <view class="error-content"><view class="error-title">登录没有完成</view><view>{{authErrorCopy}}</view></view>
      </view>

      <button class="button button-primary login-submit" bindtap="completeRegistration">完成微信登录</button>
      <view class="privacy-note"><text class="privacy-lock">✓</text>头像和昵称仅用于骑行活动中的身份展示</view>
    </view>
  </view>

  <view wx:elif="{{authError}}" class="auth-error-state">
    <view class="error-halo"><view class="error-mark">!</view></view>
    <view class="state-eyebrow">连接中断</view>
    <view class="state-title">登录没有完成</view>
    <view class="state-copy">{{authErrorCopy}}</view>
    <button class="button button-primary state-action" bindtap="retryAuth">重新尝试</button>
    <view class="state-hint">请确认网络正常后重试</view>
  </view>

  <block wx:else>
    <view class="profile">
      <view class="avatar-ring">
        <image wx:if="{{account.avatarUrl}}" class="avatar avatar-image" src="{{account.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar">{{avatarText}}</view>
      </view>
      <view class="profile-copy">
        <view class="profile-name">{{account.nickname || '微信骑友'}}</view>
        <view class="profile-note"><text></text>微信账号已登录</view>
      </view>
      <button class="profile-edit" bindtap="editProfile">编辑资料</button>
    </view>

    <view class="profile-summary">
      <view><text>{{registered.length}}</text><text>报名活动</text></view>
      <view><text>{{published.length}}</text><text>发布活动</text></view>
      <view><text>骑行者</text><text>当前身份</text></view>
    </view>

    <view class="segment-wrap">
      <view class="segment">
        <button class="segment-button {{active === 'registered' ? 'segment-on' : ''}}" data-value="registered" bindtap="switchSegment">我报名的</button>
        <button class="segment-button {{active === 'published' ? 'segment-on' : ''}}" data-value="published" bindtap="switchSegment">我发布的</button>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading"><text class="loading-dot"></text>正在同步活动状态</view>
    <view wx:elif="{{error}}" class="empty-state">
      <view class="empty-symbol error-symbol">!</view>
      <view class="empty-title">同步失败</view>
      <view class="empty-copy">{{error}}</view>
      <button class="button button-plain" bindtap="loadMine">重试</button>
    </view>

    <block wx:else>
      <view wx:if="{{active === 'registered' && !registered.length}}" class="empty-state">
        <view class="empty-symbol"><view class="route-glyph"></view></view>
        <view class="empty-title">还没有报名活动</view>
        <view class="empty-copy">挑一条合适的路线，认识一群同频的骑友。</view>
        <button class="button button-primary" bindtap="goExplore">去发现活动</button>
      </view>
      <view wx:if="{{active === 'published' && !published.length}}" class="empty-state">
        <view class="empty-symbol plus-symbol">+</view>
        <view class="empty-title">还没有发布活动</view>
        <view class="empty-copy">从已有路书开始，几分钟内创建一场骑行。</view>
        <button class="button button-primary" bindtap="goPublish">创建活动</button>
      </view>

      <view wx:if="{{active === 'registered' && registered.length}}" class="content mine-content">
        <view class="list-caption">近期参与</view>
        <view wx:for="{{registered}}" wx:key="id" class="card mine-card" data-id="{{item.id}}" bindtap="openEvent">
          <view class="row-between"><text class="badge {{item.statusTone}}">{{item.statusText}}</text><text class="small">{{item.dateText}}</text></view>
          <view class="title mine-title">{{item.title}}</view>
          <view class="meta-line"><view class="meta-dot"></view><view>{{item.meetingPoint}}</view></view>
          <view class="ride-metrics">
            <view><text>{{item.route.distanceKm}}</text><text>公里</text></view>
            <view><text>{{item.route.elevationGainM}}</text><text>爬升 m</text></view>
            <view><text>{{item.speedRange}}</text><text>巡航</text></view>
          </view>
        </view>
      </view>

      <view wx:if="{{active === 'published' && published.length}}" class="content mine-content">
        <view class="list-heading"><view><view class="list-caption">我的组织</view><view class="edit-hint">活动发布后仍可更新信息</view></view></view>
        <view wx:for="{{published}}" wx:key="id" class="card mine-card" data-id="{{item.id}}" bindtap="openEvent">
          <button class="edit-button" catchtap="editEvent" data-id="{{item.id}}">编辑</button>
          <view class="row-between card-status"><text class="badge {{item.statusTone}}">{{item.statusText}}</text><text class="small">{{item.registeredCount}} / {{item.capacity}} 人</text></view>
          <view class="title mine-title">{{item.title}}</view>
          <view class="meta-line"><view class="meta-dot"></view><view>{{item.dateText}}</view></view>
          <view class="meta-line"><view class="meta-dot"></view><view>{{item.meetingPoint}}</view></view>
        </view>
      </view>
    </block>
  </block>
</view>
