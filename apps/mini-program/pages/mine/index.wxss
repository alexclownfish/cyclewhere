.mine-page { background: var(--canvas); }

.auth-loading { min-height: 100vh; padding: 250rpx 44rpx 80rpx; text-align: center; background: #fff; }
.loading-mark { display: flex; align-items: center; justify-content: center; width: 118rpx; height: 118rpx; margin: 0 auto 30rpx; border-radius: 36rpx; background: var(--green-soft); }
.loading-pulse { width: 30rpx; height: 30rpx; border: 7rpx solid rgba(8, 127, 91, .2); border-top-color: var(--green); border-radius: 50%; animation: auth-spin .9s linear infinite; }
.loading-title { color: var(--ink); font-size: 34rpx; font-weight: 750; }
.loading-copy { margin-top: 12rpx; color: var(--muted); font-size: 24rpx; }
@keyframes auth-spin { to { transform: rotate(360deg); } }

.login-shell { min-height: 100vh; padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); background: var(--canvas); }
.login-hero { padding: 70rpx 44rpx 82rpx; background: var(--green-soft); }
.login-brand { display: flex; align-items: center; gap: 12rpx; color: var(--green-strong); font-size: 23rpx; font-weight: 700; }
.brand-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 8rpx rgba(8, 127, 91, .1); }
.login-title { max-width: 610rpx; margin-top: 32rpx; color: var(--ink); font-size: 48rpx; line-height: 1.2; font-weight: 800; }
.login-copy { max-width: 610rpx; margin-top: 18rpx; color: #52615b; font-size: 25rpx; line-height: 1.65; }
.login-panel { position: relative; margin: -42rpx 28rpx 0; padding: 38rpx 32rpx 34rpx; border: 1rpx solid rgba(60, 60, 67, .07); border-radius: 24rpx; background: rgba(255, 255, 255, .98); box-shadow: 0 18rpx 52rpx rgba(8, 60, 43, .09); }
.avatar-section { text-align: center; }
.avatar-picker { position: relative; display: flex; align-items: center; justify-content: center; width: 152rpx; height: 152rpx; margin: 0 auto; padding: 0; overflow: visible; border: 8rpx solid #fff; border-radius: 50%; background: var(--green-soft); box-shadow: 0 0 0 2rpx rgba(8, 127, 91, .16), 0 12rpx 28rpx rgba(8, 60, 43, .12); }
.avatar-picker image { display: block; width: 100%; height: 100%; overflow: hidden; border-radius: 50%; }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; border-radius: 50%; color: var(--green); font-size: 54rpx; font-weight: 400; }
.avatar-placeholder text { transform: translateY(-3rpx); }
.avatar-action { position: absolute; right: -3rpx; bottom: -3rpx; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border: 5rpx solid #fff; border-radius: 50%; background: var(--green); color: #fff; font-size: 30rpx; font-weight: 500; line-height: 1; }
.avatar-label { margin-top: 20rpx; color: var(--ink); font-size: 27rpx; font-weight: 700; }
.avatar-help { margin-top: 6rpx; color: var(--muted); font-size: 21rpx; }
.form-divider { height: 1rpx; margin: 30rpx 0 26rpx; background: var(--line); }
.login-field { text-align: left; }
.field-label { margin-bottom: 12rpx; color: #3a3a3c; font-size: 23rpx; font-weight: 650; }
.nickname-input { width: 100%; min-height: 92rpx; padding: 0 24rpx; border: 1rpx solid rgba(60, 60, 67, .08); border-radius: 18rpx; background: rgba(118, 118, 128, .08); color: var(--ink); font-size: 28rpx; text-align: left; }
.input-placeholder { color: #a0a6aa; }
.login-error { display: flex; align-items: flex-start; gap: 14rpx; margin-top: 20rpx; padding: 18rpx; border-radius: 16rpx; background: var(--red-soft); color: #b42318; font-size: 22rpx; line-height: 1.55; text-align: left; }
.error-indicator { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-top: 1rpx; border-radius: 50%; background: var(--red); color: #fff; font-size: 21rpx; font-weight: 800; }
.error-content { flex: 1; min-width: 0; word-break: break-all; }
.error-title { margin-bottom: 3rpx; color: #8f1d16; font-weight: 700; }
.login-submit { width: 100%; margin-top: 28rpx; border-radius: 22rpx; box-shadow: 0 12rpx 28rpx rgba(8, 127, 91, .18); }
.privacy-note { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 22rpx; color: var(--muted); font-size: 20rpx; line-height: 1.5; }
.privacy-lock { display: flex; align-items: center; justify-content: center; width: 25rpx; height: 25rpx; border-radius: 50%; background: var(--green-soft); color: var(--green); font-size: 17rpx; font-weight: 800; }
.simple-login-panel { padding-top: 30rpx; }
.simple-login-panel .login-error { margin-top: 0; margin-bottom: 22rpx; }
.phone-login-submit { width: 100%; margin-top: 18rpx; border: 1rpx solid rgba(8,127,91,.2); border-radius: 22rpx; background: #fff; color: var(--green-strong); }
.compact-edit-hero { padding-bottom: 76rpx; }
.cancel-edit { width: 100%; margin-top: 14rpx; border-radius: 22rpx; background: transparent; color: var(--muted); }

.auth-error-state { min-height: 100vh; padding: 174rpx 48rpx 80rpx; text-align: center; background: #fff; }
.error-halo { display: flex; align-items: center; justify-content: center; width: 142rpx; height: 142rpx; margin: 0 auto 30rpx; border-radius: 44rpx; background: var(--red-soft); }
.error-mark { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: 50%; background: var(--red); color: #fff; font-size: 44rpx; font-weight: 800; box-shadow: 0 14rpx 30rpx rgba(255, 59, 48, .18); }
.state-eyebrow { color: var(--red); font-size: 22rpx; font-weight: 700; }
.state-title { margin-top: 10rpx; color: var(--ink); font-size: 40rpx; font-weight: 800; }
.state-copy { max-width: 570rpx; margin: 18rpx auto 38rpx; color: var(--muted); font-size: 25rpx; line-height: 1.65; word-break: break-all; }
.state-action { max-width: 520rpx; margin: 0 auto; }
.state-hint { margin-top: 20rpx; color: var(--muted); font-size: 21rpx; }

.profile { position: relative; display: flex; align-items: center; gap: 20rpx; padding: 38rpx 30rpx 30rpx; background: #fff; }
.avatar-ring { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--green-soft); }
.avatar { display: flex; align-items: center; justify-content: center; width: 92rpx; height: 92rpx; overflow: hidden; border-radius: 50%; background: var(--green); color: #fff; font-size: 35rpx; font-weight: 800; box-shadow: 0 10rpx 24rpx rgba(8, 127, 91, .2); }
.avatar-image { display: block; }
.profile-copy { flex: 1; min-width: 0; padding-right: 120rpx; }
.profile-name { overflow: hidden; color: var(--ink); font-size: 37rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.profile-note { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; color: var(--muted); font-size: 23rpx; }
.profile-note text { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--green); }
.profile-edit { position: absolute; right: 28rpx; top: 60rpx; min-height: 54rpx; margin: 0; padding: 0 18rpx; border-radius: 27rpx; background: var(--green-soft); color: var(--green-strong); font-size: 21rpx; font-weight: 650; line-height: 54rpx; }
.profile-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); padding: 4rpx 22rpx 30rpx; border-bottom: 1rpx solid var(--line); background: #fff; }
.profile-summary view { min-width: 0; padding: 14rpx 12rpx; border-right: 1rpx solid var(--line); text-align: center; }
.profile-summary view:last-child { border-right: 0; }
.profile-summary text { display: block; overflow: hidden; color: var(--ink); font-size: 27rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.profile-summary text + text { margin-top: 5rpx; color: var(--muted); font-size: 19rpx; font-weight: 500; }
.phone-binding { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 30rpx 26rpx; border-top: 1rpx solid var(--line); background: #fff; }
.phone-binding-title { color: var(--ink); font-size: 25rpx; font-weight: 700; }
.phone-binding-copy { margin-top: 5rpx; color: var(--muted); font-size: 21rpx; }
.phone-bind-button { min-width: 112rpx; min-height: 58rpx; margin: 0; padding: 0 22rpx; border-radius: 29rpx; background: var(--green-soft); color: var(--green-strong); font-size: 22rpx; font-weight: 700; line-height: 58rpx; }
.segment-wrap { position: sticky; z-index: 3; top: 0; padding: 18rpx 28rpx; background: rgba(243, 247, 245, .94); backdrop-filter: blur(20px); }
.segment { display: grid; grid-template-columns: 1fr 1fr; padding: 6rpx; border: 1rpx solid rgba(60, 60, 67, .08); border-radius: 16rpx; background: rgba(118, 118, 128, .1); }
.segment-button { min-height: 72rpx; margin: 0; border-radius: 13rpx; background: transparent; color: var(--muted); font-size: 24rpx; line-height: 72rpx; }
.segment-on { background: #fff; color: var(--green-strong); font-weight: 750; box-shadow: 0 3rpx 12rpx rgba(8, 56, 42, .09); }
.mine-content { padding-top: 12rpx; }
.list-heading { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 18rpx; }
.list-caption { margin: 0 2rpx 18rpx; color: var(--ink); font-size: 26rpx; font-weight: 750; }
.list-heading .list-caption { margin-bottom: 3rpx; }
.edit-hint { color: var(--muted); font-size: 21rpx; }
.mine-card { position: relative; padding: 26rpx; border: 1rpx solid rgba(60, 60, 67, .06); }
.mine-card::before { position: absolute; top: 0; left: 26rpx; width: 72rpx; height: 5rpx; border-radius: 3rpx; background: var(--green); content: ""; }
.card-status { padding-right: 104rpx; }
.edit-button { position: absolute; z-index: 1; top: 18rpx; right: 20rpx; min-width: 86rpx; min-height: 54rpx; margin: 0; padding: 0 18rpx; border-radius: 27rpx; background: var(--green-soft); color: var(--green-strong); font-size: 21rpx; font-weight: 650; line-height: 54rpx; }
.mine-title { margin-top: 20rpx; font-size: 33rpx; }
.meta-line { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; color: var(--muted); font-size: 24rpx; line-height: 1.45; }
.meta-dot { flex: 0 0 auto; width: 8rpx; height: 8rpx; border-radius: 50%; background: rgba(8, 127, 91, .55); }
.ride-metrics { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.ride-metrics view { min-width: 0; padding: 0 12rpx; border-right: 1rpx solid var(--line); text-align: center; }
.ride-metrics view:first-child { padding-left: 0; }
.ride-metrics view:last-child { padding-right: 0; border-right: 0; }
.ride-metrics text { display: block; overflow: hidden; color: var(--ink); font-size: 25rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.ride-metrics text + text { margin-top: 5rpx; color: var(--muted); font-size: 19rpx; font-weight: 500; }
.empty-state { min-height: 620rpx; padding: 90rpx 44rpx 60rpx; }
.empty-symbol { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; margin: 0 auto 26rpx; border-radius: 34rpx; background: var(--green-soft); color: var(--green); font-size: 52rpx; font-weight: 500; }
.route-glyph { width: 42rpx; height: 42rpx; border: 7rpx solid var(--green); border-right-color: transparent; border-radius: 50%; transform: rotate(-20deg); }
.plus-symbol { font-size: 48rpx; }
.error-symbol { background: var(--red-soft); color: var(--red); }
.empty-state .button { max-width: 500rpx; margin: 0 auto; }
