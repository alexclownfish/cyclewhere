page { background: #f3f7f5; }
.privacy-page { min-height: 100vh; color: #1c1c1e; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif; }
.consent-screen { display: flex; min-height: 100vh; flex-direction: column; background: #f3f7f5; }
.hero { flex: 1; padding: 142rpx 46rpx 64rpx; text-align: center; }
.brand-mark { position: relative; width: 174rpx; height: 132rpx; margin: 0 auto; }
.mark-road { position: absolute; top: 8rpx; left: 50%; width: 70rpx; height: 108rpx; border-radius: 18rpx 18rpx 44rpx 44rpx; background: #087f5b; transform: translateX(-50%) perspective(90rpx) rotateX(8deg); }
.mark-road::after { position: absolute; top: 18rpx; left: 32rpx; width: 6rpx; height: 58rpx; border-radius: 4rpx; background: rgba(255,255,255,.88); content: ""; }
.mark-wheel { position: absolute; bottom: 0; width: 62rpx; height: 62rpx; border: 8rpx solid #17352a; border-radius: 50%; background: #f3f7f5; }
.mark-wheel-left { left: 0; }.mark-wheel-right { right: 0; }
.brand-name { margin-top: 30rpx; color: #17352a; font-size: 52rpx; font-weight: 800; }.brand-copy { margin-top: 15rpx; color: #68766f; font-size: 25rpx; }
.privacy-sheet { padding: 20rpx 40rpx calc(44rpx + env(safe-area-inset-bottom)); border-radius: 40rpx 40rpx 0 0; background: rgba(255,255,255,.96); box-shadow: 0 -18rpx 48rpx rgba(8, 77, 54, .07); }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 0 auto 30rpx; border-radius: 8rpx; background: rgba(60,60,67,.18); }.sheet-title { text-align: center; font-size: 38rpx; font-weight: 800; }.sheet-subtitle { margin-top: 9rpx; color: #8e8e93; font-size: 24rpx; text-align: center; }
.policy-copy { margin-top: 30rpx; color: #4a4a4d; font-size: 24rpx; line-height: 1.72; }.policy-link { margin-top: 10rpx; color: #087f5b; font-size: 24rpx; font-weight: 650; }
.privacy-error { margin-top: 20rpx; padding: 16rpx 18rpx; border-radius: 16rpx; background: rgba(255,59,48,.1); color: #b42318; font-size: 22rpx; line-height: 1.5; }
.consent-actions { display: flex; gap: 16rpx; margin-top: 34rpx; }.browse-button, .agree-button { display: flex; flex: 1; align-items: center; justify-content: center; min-height: 94rpx; margin: 0; padding: 0 18rpx; border-radius: 23rpx; font-size: 28rpx; font-weight: 700; }.browse-button { background: rgba(8,127,91,.11); color: #056646; }.agree-button { background: #087f5b; color: #fff; box-shadow: 0 14rpx 28rpx rgba(8,127,91,.2); }
.profile-screen { min-height: 100vh; padding: 104rpx 30rpx calc(48rpx + env(safe-area-inset-bottom)); background: linear-gradient(160deg, #e2f4ea 0, #f6faf8 42%, #f3f7f5 100%); }.profile-top { padding: 0 18rpx 52rpx; }.profile-kicker { color: #087f5b; font-size: 23rpx; font-weight: 700; }.profile-title { margin-top: 14rpx; font-size: 47rpx; font-weight: 800; line-height: 1.22; }.profile-copy { margin-top: 18rpx; color: #68766f; font-size: 25rpx; line-height: 1.6; }
.profile-card { padding: 40rpx 30rpx 30rpx; border: 1rpx solid rgba(255,255,255,.8); border-radius: 28rpx; background: rgba(255,255,255,.94); box-shadow: 0 18rpx 50rpx rgba(8,77,54,.09); }.avatar-picker { position: relative; display: flex; align-items: center; justify-content: center; width: 152rpx; height: 152rpx; margin: 0 auto; padding: 0; overflow: visible; border: 8rpx solid #fff; border-radius: 50%; background: rgba(8,127,91,.12); box-shadow: 0 0 0 2rpx rgba(8,127,91,.14); }.avatar-picker image { width: 100%; height: 100%; overflow: hidden; border-radius: 50%; }.avatar-placeholder { color: #087f5b; font-size: 54rpx; }.avatar-badge { position: absolute; right: -3rpx; bottom: -3rpx; display: flex; align-items: center; justify-content: center; width: 48rpx; height: 48rpx; border: 5rpx solid #fff; border-radius: 50%; background: #087f5b; color: #fff; font-size: 31rpx; }.avatar-label { margin: 18rpx 0 34rpx; color: #1c1c1e; font-size: 27rpx; font-weight: 700; text-align: center; }
.field-label { margin-bottom: 12rpx; color: #3a3a3c; font-size: 23rpx; font-weight: 650; }.nickname-input { width: 100%; min-height: 92rpx; padding: 0 24rpx; border-radius: 18rpx; background: rgba(118,118,128,.1); color: #1c1c1e; font-size: 28rpx; }.input-placeholder { color: #a0a6aa; }.complete-button, .back-button { display: flex; align-items: center; justify-content: center; width: 100%; min-height: 96rpx; margin: 28rpx 0 0; border-radius: 23rpx; font-size: 28rpx; font-weight: 700; }.complete-button { background: #087f5b; color: #fff; }.back-button { margin-top: 10rpx; background: transparent; color: #68766f; }
button::after { border: 0; }
