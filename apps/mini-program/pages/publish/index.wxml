<view class="page publish-page">
  <view class="publish-head">
    <view class="head-topline"><view class="head-kicker">{{editingId ? '管理活动' : '发起骑行'}}</view><view class="head-step">信息确认</view></view>
    <view class="head-title">{{editingId ? '编辑活动信息' : '创建一场骑行'}}</view>
    <view class="head-copy">{{editingId ? '调整活动说明与同行要求，保存后立即生效。' : '把路线、节奏与同行规则说清楚，让每一次出发更安心。'}}</view>
    <view class="steps"><view class="step step-on"></view><view class="step step-on"></view><view class="step step-on"></view><view class="step step-on"></view></view>
  </view>

  <view wx:if="{{authChecking}}" class="state-banner"><view class="state-dot"></view><view class="state-copy">正在确认登录状态…</view></view>
  <view wx:elif="{{authError}}" class="state-banner state-error"><view class="state-icon">!</view><view class="state-content"><view class="state-title">需要微信登录</view><view class="state-copy">{{authError}}</view></view><button class="state-action" bindtap="authorizeLogin">授权登录</button></view>
  <view wx:if="{{routesError}}" class="state-banner state-error"><view class="state-icon">!</view><view class="state-content"><view class="state-title">路书加载失败</view><view class="state-copy">{{routesError}}</view></view><button class="state-action" bindtap="loadRoutes">重试</button></view>

  <view wx:if="{{editingId}}" class="state-banner"><view class="state-dot"></view><view class="state-copy">正在编辑已发布活动，仅组织者可保存</view></view>

  <view class="gpx-import">
    <view class="gpx-copy"><view class="form-title">导入自己的路书</view><view class="section-copy">支持 GPX 文件；iGPSPORT 路书请先导出 GPX 后选择文件</view></view>
    <button class="button button-plain gpx-button" loading="{{importingGpx}}" disabled="{{importingGpx || !authReady}}" bindtap="importGpx">{{importingGpx ? '导入中' : '选择 GPX'}}</button>
  </view>

  <view class="form-section first-section">
    <view class="section-head"><view class="section-index">01</view><view><view class="form-title">路书与基础信息</view><view class="section-copy">先确定路线与出发安排</view></view></view>
    <view class="field"><label class="label">活动路书 <text class="optional-label">选填</text></label><picker range="{{routeOptions}}" range-key="name" value="{{routeIndex}}" bindchange="onRoute"><view class="route-picker {{selectedRoute ? '' : 'route-picker-empty'}}"><image wx:if="{{selectedRoute}}" src="{{selectedRoute.cover}}" mode="aspectFill" /><view wx:else class="route-empty-icon">⌁</view><view class="route-picker-copy"><view class="route-name">{{selectedRoute ? selectedRoute.name : '不选择路书'}}</view><view class="small">{{selectedRoute ? (selectedRoute.distanceKm + ' km · 爬升 ' + selectedRoute.elevationGainM + ' m') : '可直接发布活动，稍后再补充路线'}}</view></view><view class="chevron">›</view></view></picker></view>
    <view wx:if="{{!selectedRoute}}" class="manual-route-fields">
      <view class="field-row"><view class="field"><label class="label required">预计距离</label><view class="unit-input"><input type="digit" value="{{form.distanceKm || ''}}" placeholder="例如 60" data-field="distanceKm" bindinput="onNumber" /><text>km</text></view></view><view class="field"><label class="label">预计爬升</label><view class="unit-input"><input type="number" value="{{form.elevationGainM || ''}}" placeholder="例如 500" data-field="elevationGainM" bindinput="onNumber" /><text>m</text></view></view></view>
      <view class="field"><label class="label required">活动难度</label><picker range="{{difficultyOptions}}" value="{{difficultyIndex}}" bindchange="onDifficulty"><view class="picker">{{form.difficulty}}<text class="picker-icon">⌄</text></view></picker></view>
    </view>
    <view class="field"><label class="label required">活动名称</label><input class="input" maxlength="30" value="{{form.title}}" data-field="title" bindinput="onField" /></view>
    <view class="field"><label class="label">活动封面</label><view class="cover-picker" bindtap="chooseCover"><image wx:if="{{coverPreview}}" src="{{coverPreview}}" mode="aspectFill" /><view wx:else class="cover-placeholder"><view class="cover-plus">+</view><text>添加一张能代表路线的照片</text></view><view wx:if="{{coverPreview}}" class="cover-edit">更换封面</view></view></view>
    <view class="field-row"><view class="field"><label class="label required">出发日期</label><picker mode="date" value="{{form.date}}" start="2026-08-06" bindchange="onDate"><view class="picker">{{form.date}}<text class="picker-icon">⌄</text></view></picker></view><view class="field"><label class="label required">集合时间</label><picker mode="time" value="{{form.time}}" bindchange="onTime"><view class="picker">{{form.time}}<text class="picker-icon">⌄</text></view></picker></view></view>
    <view class="field location-field"><label class="label required">集合地点</label><view class="location-input-row"><input class="input location-input" maxlength="50" value="{{form.meetingPoint}}" data-field="meetingPoint" bindinput="onField" bindfocus="showLocationSuggestions" bindblur="hideLocationSuggestions" placeholder="输入地铁站、停车场或地标" /><button class="map-location-button" bindtap="chooseMeetingPointOnMap">地图选点</button></view><view wx:if="{{showLocationSuggestions}}" class="location-suggestions"><view wx:for="{{locationSuggestions}}" wx:key="label" class="location-suggestion" data-label="{{item.label}}" catchtap="chooseMeetingPoint"><view class="suggestion-pin">⌖</view><view class="suggestion-copy"><view class="suggestion-label">{{item.label}}</view><view class="suggestion-note">{{item.note}}</view></view></view></view></view>
  </view>

  <view class="form-section">
    <view class="section-head"><view class="section-index">02</view><view><view class="form-title">队伍设置</view><view class="section-copy">设定人数与舒适巡航区间</view></view></view>
    <view class="field-row"><view class="field"><label class="label required">人数上限</label><input class="input" type="number" value="{{form.capacity}}" data-field="capacity" bindinput="onNumber" /></view><view class="field"><label class="label required">巡航速度</label><input class="input" value="{{form.speedRange}}" data-field="speedRange" bindinput="onField" /></view></view>
    <view class="field"><label class="label">活动说明</label><textarea class="textarea" maxlength="300" value="{{form.description}}" data-field="description" bindinput="onField" /></view>
  </view>

  <view class="form-section">
    <view class="section-head"><view class="section-index">03</view><view><view class="form-title">装备与能力要求</view><view class="section-copy">帮助骑友判断是否适合参加</view></view></view>
    <view class="field"><label class="label required">必备装备</label><view class="option-grid"><view wx:for="{{equipmentOptions}}" wx:key="label" class="option {{item.selected ? 'option-selected' : ''}}" data-group="equipmentOptions" data-index="{{index}}" bindtap="toggleOption"><view class="check-box">{{item.selected ? '✓' : ''}}</view><text>{{item.label}}</text></view></view></view>
    <view class="field-row"><view class="field"><label class="label">近 30 天单次距离</label><view class="unit-input"><input type="number" value="{{form.requirements.recentDistanceKm}}" data-field="requirements.recentDistanceKm" bindinput="onNumber" /><text>km</text></view></view><view class="field"><label class="label">近 30 天累计爬升</label><view class="unit-input"><input type="number" value="{{form.requirements.recentElevationM}}" data-field="requirements.recentElevationM" bindinput="onNumber" /><text>m</text></view></view></view>
    <view class="field"><label class="label required">允许车型</label><view class="option-grid"><view wx:for="{{bikeOptions}}" wx:key="label" class="option {{item.selected ? 'option-selected' : ''}}" data-group="bikeOptions" data-index="{{index}}" bindtap="toggleOption"><view class="check-box">{{item.selected ? '✓' : ''}}</view><text>{{item.label}}</text></view></view></view>
  </view>

  <view class="form-section">
    <view class="section-head"><view class="section-index">04</view><view><view class="form-title">骑行纪律与风险</view><view class="section-copy">提前建立一致的同行预期</view></view></view>
    <view class="field"><label class="label required">报名时必须确认</label><view class="option-grid"><view wx:for="{{disciplineOptions}}" wx:key="label" class="option discipline {{item.selected ? 'option-selected' : ''}}" data-group="disciplineOptions" data-index="{{index}}" bindtap="toggleOption"><view class="check-box">{{item.selected ? '✓' : ''}}</view><text>{{item.label}}</text></view></view></view>
    <view class="field"><label class="label">补充说明</label><textarea class="textarea" maxlength="200" placeholder="例如：连续爬坡长度、下坡风险、掉队安排" value="{{form.requirements.customNote}}" data-field="requirements.customNote" bindinput="onField" /></view>
    <view class="notice"><view class="notice-mark">✓</view><view>已选择 {{form.requirements.equipment.length}} 项装备、{{form.requirements.bikeTypes.length}} 种车型和 {{form.requirements.disciplines.length}} 条纪律。发布后会同步展示在详情与报名确认页。</view></view>
  </view>

  <view class="sticky-actions"><button class="button button-primary" loading="{{submitting}}" disabled="{{submitting || !authReady}}" bindtap="submit">{{authReady ? (editingId ? '保存修改' : '确认发布') : '登录后继续'}}</button></view>

  <view wx:if="{{appleModal.visible}}" class="apple-modal-backdrop" catchtouchmove="noop" catchtap="noop">
    <view class="apple-modal" catchtap="noop">
      <view class="apple-modal-title">{{appleModal.title}}</view>
      <view class="apple-modal-content">{{appleModal.content}}</view>
      <view class="apple-modal-actions">
        <button wx:if="{{appleModal.showCancel}}" class="apple-modal-button apple-modal-cancel" data-confirm="false" catchtap="resolveAppleModal">{{appleModal.cancelText}}</button>
        <button class="apple-modal-button {{appleModal.destructive ? 'apple-modal-destructive' : ''}}" data-confirm="true" catchtap="resolveAppleModal">{{appleModal.confirmText}}</button>
      </view>
    </view>
  </view>
</view>
