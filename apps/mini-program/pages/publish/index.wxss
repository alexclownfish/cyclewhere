.publish-page { background: var(--canvas); }
.publish-head { padding: 36rpx 30rpx 32rpx; background: #fff; border-bottom: 1rpx solid var(--line); }
.head-topline { display: flex; align-items: center; justify-content: space-between; }
.head-kicker, .head-step { display: inline-flex; align-items: center; min-height: 44rpx; padding: 0 16rpx; border-radius: 22rpx; font-size: 22rpx; font-weight: 700; }
.head-kicker { background: var(--green-soft); color: var(--green-strong); }
.head-step { background: rgba(118,118,128,.08); color: var(--muted); }
.head-title { margin-top: 22rpx; font-size: 46rpx; line-height: 1.22; font-weight: 800; }
.head-copy { max-width: 630rpx; margin-top: 12rpx; color: var(--muted); font-size: 25rpx; line-height: 1.65; }
.steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; margin-top: 28rpx; }
.step { height: 7rpx; border-radius: 4rpx; background: rgba(118,118,128,.12); }
.step-on { background: var(--green); }
.state-banner { display: flex; align-items: center; gap: 16rpx; margin: 18rpx 28rpx 0; padding: 20rpx; border: 1rpx solid rgba(8,127,91,.16); border-radius: 16rpx; background: #fff; color: var(--green-strong); font-size: 24rpx; box-shadow: 0 8rpx 24rpx rgba(8,56,42,.05); }
.state-dot { flex: 0 0 auto; width: 16rpx; height: 16rpx; border-radius: 50%; background: var(--green); }
.state-error { border-color: rgba(255,59,48,.18); background: #fff; color: #a52620; }
.state-icon { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; background: var(--red-soft); color: var(--red); font-weight: 800; }
.state-content { flex: 1; min-width: 0; }
.state-title { font-weight: 750; }
.state-copy { margin-top: 5rpx; line-height: 1.5; word-break: break-all; }
.state-action { flex: 0 0 auto; min-width: 126rpx; min-height: 68rpx; margin: 0; padding: 0 18rpx; border-radius: 18rpx; background: var(--red-soft); color: #a52620; font-size: 24rpx; line-height: 68rpx; }
.form-section { margin: 18rpx 24rpx 0; padding: 30rpx 26rpx 32rpx; border: 1rpx solid rgba(60,60,67,.08); border-radius: 16rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(8,56,42,.04); }
.first-section { margin-top: 22rpx; }
.gpx-import { display: flex; align-items: center; gap: 18rpx; margin: 18rpx 24rpx 0; padding: 24rpx; border: 1rpx solid rgba(8,127,91,.15); border-radius: 16rpx; background: var(--green-soft); }
.gpx-copy { flex: 1; min-width: 0; }
.gpx-button { flex: 0 0 auto; width: 190rpx; margin: 0; }
.section-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 30rpx; }
.section-index { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 16rpx; background: var(--green-soft); color: var(--green); font-size: 22rpx; font-weight: 800; }
.form-title { margin: 0; font-size: 31rpx; line-height: 1.25; font-weight: 780; }
.section-copy { margin-top: 5rpx; color: var(--muted); font-size: 22rpx; }
.field-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; }
.route-picker { display: flex; align-items: center; gap: 18rpx; min-height: 124rpx; padding: 12rpx; border: 1rpx solid rgba(8,127,91,.14); border-radius: 16rpx; background: rgba(8,127,91,.045); }
.route-picker image { flex: 0 0 auto; width: 126rpx; height: 96rpx; border-radius: 12rpx; background: #e6efeb; }
.cover-picker { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; height: 250rpx; overflow: hidden; border: 1rpx dashed rgba(8,127,91,.28); border-radius: 18rpx; background: rgba(8,127,91,.045); }
.cover-picker image { width: 100%; height: 100%; }
.cover-placeholder { display: flex; align-items: center; justify-content: center; gap: 12rpx; color: var(--green-strong); font-size: 23rpx; }
.cover-plus { display: flex; align-items: center; justify-content: center; width: 54rpx; height: 54rpx; border-radius: 50%; background: var(--green); color: #fff; font-size: 38rpx; font-weight: 300; line-height: 1; }
.cover-edit { position: absolute; right: 18rpx; bottom: 16rpx; padding: 10rpx 16rpx; border-radius: 18rpx; background: rgba(28,28,30,.72); color: #fff; font-size: 21rpx; }
.route-picker-copy { flex: 1; min-width: 0; }
.route-name { overflow: hidden; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.chevron { flex: 0 0 auto; padding-right: 8rpx; color: var(--green); font-size: 42rpx; font-weight: 400; }
.picker { gap: 8rpx; }
.picker-icon { color: var(--green); font-size: 24rpx; }
.input, .textarea, .picker, .unit-input { border: 1rpx solid transparent; transition: border-color .18s ease, background .18s ease; }
.input:focus, .textarea:focus { border-color: rgba(8,127,91,.35); background: rgba(8,127,91,.055); }
.unit-input { display: flex; align-items: center; min-height: 88rpx; padding: 0 18rpx; border-radius: 20rpx; background: rgba(118,118,128,.1); }
.unit-input input { min-width: 0; flex: 1; }
.unit-input text { color: var(--muted); font-size: 23rpx; }
.option { gap: 0; border: 1rpx solid transparent; }
.option-selected { border-color: rgba(8,127,91,.16); }
.discipline { align-items: flex-start; min-height: 100rpx; line-height: 1.45; }
.discipline .check-box { margin-top: 2rpx; }
.notice { display: flex; align-items: flex-start; gap: 14rpx; }
.notice-mark { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; margin-top: 2rpx; border-radius: 50%; background: var(--green); color: #fff; font-size: 20rpx; font-weight: 800; }
.sticky-actions { margin-top: 20rpx; background: rgba(243,247,245,.94); backdrop-filter: blur(20px); }
