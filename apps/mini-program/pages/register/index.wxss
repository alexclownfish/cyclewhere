.register-page { background: var(--canvas); }
.event-brief { padding: 34rpx 30rpx 36rpx; background: #fff; border-bottom: 1rpx solid var(--line); }
.brief-top { display: flex; align-items: center; justify-content: space-between; }
.brief-status { display: flex; align-items: center; gap: 10rpx; color: var(--green-strong); font-size: 22rpx; font-weight: 650; }
.brief-status text { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 7rpx var(--green-soft); }
.brief-title { max-width: 650rpx; margin: 22rpx 0 20rpx; font-size: 42rpx; line-height: 1.32; font-weight: 800; }
.brief-meta { display: flex; align-items: center; gap: 14rpx; margin-top: 12rpx; color: #555b58; font-size: 25rpx; line-height: 1.45; }
.meta-icon { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 12rpx; background: var(--green-soft); color: var(--green-strong); font-size: 19rpx; font-weight: 750; }
.form-section { margin: 18rpx 24rpx 0; padding: 30rpx 26rpx 32rpx; border: 1rpx solid rgba(60,60,67,.08); border-radius: 16rpx; background: #fff; box-shadow: 0 10rpx 30rpx rgba(8,56,42,.04); }
.first-section { margin-top: 22rpx; }
.section-head { display: flex; align-items: center; gap: 16rpx; margin-bottom: 30rpx; }
.section-index { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 60rpx; height: 60rpx; border-radius: 16rpx; background: var(--green-soft); color: var(--green); font-size: 22rpx; font-weight: 800; }
.form-title { margin: 0; font-size: 31rpx; line-height: 1.25; font-weight: 780; }
.section-copy { margin-top: 5rpx; color: var(--muted); font-size: 22rpx; }
.input, .picker { border: 1rpx solid transparent; }
.input:focus { border-color: rgba(8,127,91,.35); background: rgba(8,127,91,.055); }
.chevron { color: var(--green); font-size: 40rpx; }
.confirm { display: flex; align-items: flex-start; gap: 18rpx; margin-bottom: 16rpx; padding: 22rpx; border: 1rpx solid transparent; border-radius: 16rpx; background: rgba(118,118,128,.075); color: #555b58; font-size: 24rpx; line-height: 1.6; }
.confirm-on { border-color: rgba(8,127,91,.18); background: var(--green-soft); color: var(--green-strong); }
.confirm-box { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 40rpx; height: 40rpx; margin-top: 2rpx; border: 2rpx solid #aeb4b7; border-radius: 10rpx; background: #fff; }
.confirm-on .confirm-box { border-color: var(--green); background: var(--green); color: #fff; }
.confirm-copy { flex: 1; min-width: 0; }
.confirm-title { margin-bottom: 5rpx; color: var(--ink); font-size: 25rpx; font-weight: 750; }
.confirm-on .confirm-title { color: var(--green-strong); }
.privacy { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); color: var(--muted); font-size: 22rpx; line-height: 1.6; }
.privacy-icon { display: flex; flex: 0 0 auto; align-items: center; justify-content: center; width: 30rpx; height: 30rpx; margin-top: 2rpx; border: 1rpx solid #aeb4b7; border-radius: 50%; font-size: 19rpx; font-weight: 700; }
.sticky-actions { margin-top: 20rpx; background: rgba(243,247,245,.94); backdrop-filter: blur(20px); }
.success-state { min-height: 100vh; padding: 132rpx 52rpx 70rpx; text-align: center; background: #fff; }
.success-halo { display: flex; align-items: center; justify-content: center; width: 158rpx; height: 158rpx; margin: 0 auto 30rpx; border-radius: 50%; background: var(--green-soft); }
.success-mark { display: flex; align-items: center; justify-content: center; width: 106rpx; height: 106rpx; border-radius: 50%; background: var(--green); color: #fff; font-size: 58rpx; font-weight: 800; box-shadow: 0 16rpx 34rpx rgba(8,127,91,.22); }
.success-kicker { color: var(--green); font-size: 22rpx; font-weight: 750; }
.success-title { margin-top: 10rpx; font-size: 43rpx; font-weight: 800; }
.success-copy { margin: 20rpx auto 44rpx; max-width: 570rpx; color: var(--muted); line-height: 1.7; }
.success-state .button { max-width: 580rpx; margin: 0 auto; }
