<view class="page">
  <view wx:if="{{loading}}" class="loading"><text class="loading-dot"></text>正在解析轨迹</view>
  <view wx:elif="{{error}}" class="empty-state"><text class="empty-icon">!</text><view class="empty-title">路书暂不可用</view><view class="empty-copy">{{error}}</view><button class="button button-plain" bindtap="loadRoute">重试</button></view>
  <block wx:elif="{{route}}">
    <view class="map-wrap">
      <map class="route-map" latitude="{{latitude}}" longitude="{{longitude}}" scale="11" polyline="{{polyline}}" markers="{{markers}}" enable-3D="{{false}}" show-location="{{false}}" />
      <view class="map-note">轨迹已抽稀 · 点位仅供参考</view>
    </view>
    <view class="route-summary">
      <view class="row-between"><text class="badge badge-green">{{route.difficulty}}</text><text class="small">{{route.city}}</text></view>
      <view class="route-title">{{route.name}}</view>
      <view class="metrics">
        <view class="metric"><text class="metric-value">{{route.distanceKm}}</text><text class="metric-label">公里</text></view>
        <view class="metric"><text class="metric-value">{{route.elevationGainM}}</text><text class="metric-label">爬升米</text></view>
        <view class="metric"><text class="metric-value">{{durationText}}</text><text class="metric-label">预计</text></view>
        <view class="metric"><text class="metric-value">{{maxGradientText}}</text><text class="metric-label">最大坡度</text></view>
      </view>
    </view>
    <view class="detail-block">
      <view class="form-title">海拔剖面 <text wx:if="{{profileEstimated}}" class="profile-estimated">示意</text></view>
      <view class="elevation"><view wx:for="{{elevationBars}}" wx:key="index" class="elevation-bar" style="height: {{item}}%"></view></view>
      <view class="row-between elevation-caption"><text>起点</text><text>累计爬升 {{route.elevationGainM}} m</text><text>终点</text></view>
    </view>
    <view class="detail-block"><view class="form-title">沿途关键点</view>
      <view wx:for="{{route.pois}}" wx:key="id" class="poi"><view class="poi-index">{{index + 1}}</view><view class="poi-copy"><view class="poi-name">{{item.name}}</view><view class="small">{{item.note}}</view></view><text class="small">{{item.distanceKm}} km</text></view>
    </view>
    <view class="notice route-notice">路线数据可能受道路施工、天气和定位偏差影响，请以现场交通规则为准。</view>
    <view class="sticky-actions"><button class="button button-dark" bindtap="openStart">导航到起点</button></view>
  </block>
</view>
