.route-head { padding: 48rpx 30rpx 42rpx; background: #fff; }
.head-kicker { color: var(--green); font-size: 23rpx; font-weight: 700; }
.head-title { margin-top: 10rpx; font-size: 48rpx; font-weight: 800; }
.head-copy { margin-top: 12rpx; color: var(--muted); font-size: 25rpx; line-height: 1.6; }
.route-cover { display: block; width: 100%; height: 310rpx; background: #dfe4e1; }
.route-title { margin: 16rpx 0 18rpx; }
.route-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; color: var(--muted); font-size: 24rpx; }
