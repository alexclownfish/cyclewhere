{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "Node",
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings", "node"]
  },
  "include": ["app.ts", "config/**/*.ts", "pages/**/*.ts", "services/**/*.ts", "types/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules", "tests"]
}
