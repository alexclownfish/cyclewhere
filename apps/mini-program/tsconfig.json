{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["miniprogram-api-typings", "node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
